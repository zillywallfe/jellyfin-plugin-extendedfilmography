<?xml version="1.0" encoding="utf-8"?>
<!--
  The verification harness needs no packages at all - only the .NET SDK and its bundled
  ASP.NET Core reference assemblies. Clearing the sources makes `dotnet run` work with no
  network access whatsoever, and makes it obvious if a PackageReference ever creeps in here.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
